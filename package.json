{
  "name": "enter-web-handbook",
  "version": "0.1.0",
  "private": true,
  "description": "VAIZO V/ENTER WEB Department Handbook — Markdown source, HTML & PDF distributables",
  "scripts": {
    "build:html": "node scripts/build.mjs --html-only",
    "build:pdf": "node scripts/build.mjs --pdf-only",
